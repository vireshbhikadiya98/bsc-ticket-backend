generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String   @id @default(uuid())
  walletAddress   String   @unique
  username        String?
  password        String
  referralCode    String   @unique
  sponsorId       String?
  sponsor         User?    @relation("ReferralTree", fields: [sponsorId], references: [id])
  referrals       User[]   @relation("ReferralTree")

  role            Role     @default(USER)
  fundingWallet   Float    @default(0.0)
  earningWallet   Float    @default(0.0)
  isVerified      Boolean  @default(true) // Set to true by default (No OTP needed)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  deposits        Deposit[]
  purchases       TicketPurchase[]
  levelProgress   UserLevelProgress[]
  referralRewards ReferralReward[]
}

// Dynamic Ticket Levels (Admin Configurable)
model TicketLevel {
  id                  Int                 @id @default(autoincrement())
  levelNumber         Int                 @unique // 1, 2, 3, 4, etc.
  name                String              // "Level 1", "Level 2"
  price               Float               // 25.0, 50.0, 75.0, 100.0
  dailyRewardPercent  Float               @default(1.0) // 1%
  requiredDaysToUnlock Int                @default(3) // 3 consecutive days of previous level needed
  isActive            Boolean             @default(true)

  purchases           TicketPurchase[]
  levelProgress       UserLevelProgress[]
}

// Tracks daily ticket purchases per user per level
model TicketPurchase {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  levelId         Int
  level           TicketLevel @relation(fields: [levelId], references: [id])

  amount          Float
  cycleDate       String      // e.g. "2026-07-30" (matches admin distribution epoch date)
  principalReturned Float     @default(0.0)
  rewardGranted   Float       @default(0.0)

  createdAt       DateTime    @default(now())
}

// Tracks consecutive purchase streak and unlocked status per user per level
model UserLevelProgress {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  levelId           Int
  level             TicketLevel @relation(fields: [levelId], references: [id])

  consecutiveDays   Int         @default(0)  // Counts consecutive days purchased (1, 2, 3...)
  isUnlocked        Boolean     @default(false)
  lastPurchaseDate  String?     // "2026-07-30"

  updatedAt         DateTime    @updatedAt

  @@unique([userId, levelId])
}

// Deposit USDT by submitting TxHash
model Deposit {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  txHash        String        @unique
  amount        Float
  status        DepositStatus @default(PENDING)
  adminNote     String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// History of Referral Earnings ($1 First Purchase Bonus & 5-Level 1% Yield)
model ReferralReward {
  id            String   @id @default(uuid())
  userId        String   // Referrer receiving reward
  user          User     @relation(fields: [userId], references: [id])
  fromUserId    String   // Downline user who bought ticket
  levelDepth    Int      // 1 to 5 (or 0 for $1 direct signup bonus)
  amount        Float
  rewardType    String   // "FIRST_PURCHASE_BONUS" or "DAILY_YIELD_MATCH"

  createdAt     DateTime @default(now())
}

// System Settings (Admin Configurable)
model SystemSetting {
  id                Int      @id @default(1)
  companyUsdtAddress String  @default("0x0000000000000000000000000000000000000000") // Admin Editable
  rewardEpochTime   String   @default("07:00") // Daily reward trigger time (HH:MM format)
  updatedAt         DateTime @updatedAt
}
